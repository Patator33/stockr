generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         String     @default("user")
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  action    String
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Product {
  id                String           @id @default(uuid())
  name              String
  description       String?
  defaultLocationId String?
  variants          ProductVariant[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model ProductVariant {
  id                String                @id @default(uuid())
  productId         String
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              String
  attributes        String                @default("[]")
  costPrice         Float                 @default(0)
  salePrice         Float                 @default(0)
  shippingCost      Float                 @default(0)
  vatRate           Float                 @default(20)
  barcode           String?               @unique
  supplierRef       String?               @unique
  lowStockThreshold Int?
  stocks            Stock[]
  sales             Sale[]
  transfers         StockTransfer[]
  orderItems        OrderItem[]
  promotions        Promotion[]
  stockMovements    StockMovement[]
  supplierPrices    VariantSupplierPrice[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model Supplier {
  id             String                @id @default(uuid())
  name           String                @unique
  description    String?
  variantPrices  VariantSupplierPrice[]
  sales          Sale[]
  promotions     Promotion[]
  createdAt      DateTime              @default(now())
}

model VariantSupplierPrice {
  id           String         @id @default(uuid())
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierRef  String?
  salePrice    Float
  costPrice    Float          @default(0)
  shippingCost Float          @default(0)
  vatRate      Float          @default(20)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([variantId, supplierId])
}

model StorageLocation {
  id             String          @id @default(uuid())
  name           String
  description    String?
  isDefault      Boolean         @default(false)
  stocks         Stock[]
  transfersFrom  StockTransfer[] @relation("FromLocation")
  transfersTo    StockTransfer[] @relation("ToLocation")
  sales          Sale[]
  orders         Order[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
}

model Stock {
  id         String          @id @default(uuid())
  variantId  String
  variant    ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId String
  location   StorageLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Int             @default(0)
  updatedAt  DateTime        @updatedAt

  @@unique([variantId, locationId])
}

model StockTransfer {
  id             String          @id @default(uuid())
  variantId      String
  variant        ProductVariant  @relation(fields: [variantId], references: [id])
  fromLocationId String
  fromLocation   StorageLocation @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     StorageLocation @relation("ToLocation", fields: [toLocationId], references: [id])
  quantity       Int
  notes          String?
  createdAt      DateTime        @default(now())
}

model Sale {
  id               String          @id @default(uuid())
  variantId        String
  variant          ProductVariant  @relation(fields: [variantId], references: [id])
  locationId       String
  location         StorageLocation @relation(fields: [locationId], references: [id])
  orderId          String?
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  supplierId       String?
  supplier         Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  quantity         Int
  unitSalePrice    Float
  unitCostPrice    Float
  unitShippingCost Float
  vatRate          Float           @default(20)
  notes            String?
  returns          Return[]
  createdAt        DateTime        @default(now())
}

model Promotion {
  id         String         @id @default(uuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  supplierId String?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  price      Float
  startDate  DateTime
  endDate    DateTime?
  createdAt  DateTime       @default(now())
}

model Return {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  quantity  Int
  reason    String?
  notes     String?
  createdAt DateTime @default(now())
}

model Order {
  id              String           @id @default(uuid())
  source          String           @default("n8n")
  customerName    String?
  customerEmail   String?
  notes           String?
  status          String           @default("pending")
  shippingDate    DateTime?
  trackingRef     String?
  locationId      String?
  location        StorageLocation? @relation(fields: [locationId], references: [id])
  items           OrderItem[]
  sales           Sale[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  barcode     String?
  variantName String
  quantity    Int
  scanned     Int             @default(0)
}

model StockMovement {
  id         String          @id @default(uuid())
  variantId  String
  variant    ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId String
  location   StorageLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type       String          // adjust, transfer_in, transfer_out, sale, return, import
  delta      Int             // positive = stock in, negative = stock out
  userId     String?
  ref        String?         // orderId, saleId, or transferId
  notes      String?
  createdAt  DateTime        @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
